# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCOUNT_ENCRYPTION_KEY=

PORT=8787
# Docker Compose 会自动设置为 0.0.0.0；本机运行时默认只监听 127.0.0.1。
# HOST=127.0.0.1

# 代理供应商配置。{sessionId} 会在每个导入账号时替换为唯一随机数字。
PROXY_HOST=global.rotgb.proxyprovider.com
PROXY_PORT=10000
PROXY_USERNAME_TEMPLATE=USERNAME-zone-custom-region-US-session-{sessionId}-sessTime-20
PROXY_PASSWORD=

# 仅限制单封邮件返回给调用方的正文大小；完整原文仍会先由 IMAP 下载。
MAX_MESSAGE_BYTES=5242880
